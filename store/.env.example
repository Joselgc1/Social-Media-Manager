# ============================================================
# VS Chatbot - Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git!
# ============================================================

# --- Channel backend ---
# meta = direct Meta WhatsApp/Instagram webhooks and senders
# kommo = Kommo official WhatsApp/Instagram integrations + Salesbot transport
CHANNEL_BACKEND=meta

# --- Meta APIs (required only when CHANNEL_BACKEND=meta in production) ---
META_APP_SECRET=your_meta_app_secret_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=any_random_string_you_choose

# Instagram (Phase 2 - leave empty for now)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=

# --- Kommo private integration (required only when CHANNEL_BACKEND=kommo in production) ---
KOMMO_SUBDOMAIN=
KOMMO_ACCESS_TOKEN=
KOMMO_INTEGRATION_ID=
KOMMO_INTEGRATION_SECRET=
KOMMO_SALESBOT_ID=
KOMMO_WEBHOOK_SECRET=
KOMMO_AI_MODE_FIELD_ID=
KOMMO_AI_ACTIVE_ENUM_ID=
KOMMO_AI_HUMAN_ENUM_ID=
KOMMO_AI_PAUSED_ENUM_ID=
KOMMO_DEFAULT_RESPONSIBLE_USER_ID=

# --- LLM Providers (at least one required; admin picks the active one) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=postgresql://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres

# --- Google Sheets ---
# Base64-encode your service account JSON: base64 -i credentials.json
GOOGLE_SHEETS_CREDENTIALS_B64=eyJ0eXBlIjoi...
PRODUCT_SHEET_ID=your_google_sheet_id_here

# --- Telegram (admin notifications) ---
# Create a bot via @BotFather, then get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_ADMIN_CHAT_ID=your_numeric_chat_id

# --- App config ---
STORE_NAME="Zona Pink"
OWNER_NAME=Carlos
APP_BASE_URL=https://your-app.railway.app
DEBUG=false

# Store admin auth (required when DEBUG=false)
ADMIN_PASSWORD=change-me

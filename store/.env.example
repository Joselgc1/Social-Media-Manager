# ============================================================
# VS Chatbot - Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git!
# ============================================================

# --- Channel backend ---
# meta = direct Meta WhatsApp/Instagram webhooks and senders
# kommo = Kommo official WhatsApp/Instagram integrations + Salesbot transport
CHANNEL_BACKEND=meta

# --- Meta APIs (required only when CHANNEL_BACKEND=meta in production) ---
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Instagram (optional; if enabled in production, set both values)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=

# --- Kommo private integration (required only when CHANNEL_BACKEND=kommo in production) ---
KOMMO_SUBDOMAIN=
KOMMO_ACCESS_TOKEN=
KOMMO_INTEGRATION_ID=
KOMMO_INTEGRATION_SECRET=
KOMMO_SALESBOT_ID=
KOMMO_WEBHOOK_SECRET=
KOMMO_AI_MODE_FIELD_ID=
KOMMO_AI_ACTIVE_ENUM_ID=
KOMMO_AI_HUMAN_ENUM_ID=
KOMMO_AI_PAUSED_ENUM_ID=
KOMMO_DEFAULT_RESPONSIBLE_USER_ID=

# --- LLM Providers (at least one required; admin picks the active one) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Database (PostgreSQL) ---
# Local example. On Railway set DATABASE_URL=${{StorePostgres.DATABASE_URL}}.
DATABASE_URL=postgresql://postgres:password@localhost:5432/store_db

# --- Google Sheets ---
# Base64-encode your service account JSON: base64 -i credentials.json
GOOGLE_SHEETS_CREDENTIALS_B64=
PRODUCT_SHEET_ID=

# --- Telegram (admin notifications) ---
# Create a bot via @BotFather, then get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# --- App config ---
STORE_NAME="Zona Pink"
OWNER_NAME=Carlos
APP_BASE_URL=https://your-app.railway.app
DEBUG=false

# --- AI orchestration rollout ---
# Runtime DB setting ai_orchestration_mode takes precedence when present.
# Allowed values: legacy, shadow, multi_agent. Keep legacy until rollout.
AI_ORCHESTRATION_MODE=legacy

# Store admin auth (required when DEBUG=false; generate with: python -c "import secrets; print(secrets.token_urlsafe(24))")
ADMIN_PASSWORD=

# --- Multi-store / customization ---
# If set, replaces prompts/system_prompt.md. Must keep the same template placeholders.
SYSTEM_PROMPT_OVERRIDE=

# When true, LLM controls are locked locally and managed from master/.
LLM_MANAGED_EXTERNALLY=false

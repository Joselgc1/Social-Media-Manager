# ============================================================
# VS Chatbot - Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git!
# ============================================================

# --- Channel backend ---
# meta = direct Meta WhatsApp/Instagram webhooks and senders
# kommo = WhatsApp Salesbot + direct Instagram DM Chats API transport
CHANNEL_BACKEND=kommo

# --- Meta APIs (required only when CHANNEL_BACKEND=meta in production) ---
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Instagram direct API or optional context provider alongside Kommo
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCOUNT_ID=
META_GRAPH_API_VERSION=v26.0

# Context-only Meta webhook. Kommo remains responsible for all response delivery.
META_INSTAGRAM_CONTEXT_ENABLED=false
META_CONTEXT_WAIT_SECONDS=10
META_CONTEXT_MATCH_WINDOW_SECONDS=45
META_CONTEXT_EVENT_RETENTION_HOURS=24
META_STORY_CONTEXT_ENABLED=false
META_STORY_CONTEXT_WAIT_SECONDS=3
META_STORY_CONTEXT_MATCH_WINDOW_SECONDS=45
INSTAGRAM_STORY_MAPPING_TTL_HOURS=24
INSTAGRAM_STORY_CONTEXT_TTL_HOURS=24

# --- Kommo private integration (required only when CHANNEL_BACKEND=kommo in production) ---
KOMMO_SUBDOMAIN=
KOMMO_ACCESS_TOKEN=
KOMMO_INTEGRATION_ID=
KOMMO_INTEGRATION_SECRET=
# WhatsApp private-message Salesbot
KOMMO_WHATSAPP_SALESBOT_ID=
# Temporary WhatsApp-only Salesbot fallback
KOMMO_SALESBOT_ID=
KOMMO_WEBHOOK_SECRET=
KOMMO_AI_MODE_FIELD_ID=
KOMMO_AI_ACTIVE_ENUM_ID=
KOMMO_AI_HUMAN_ENUM_ID=
KOMMO_AI_PAUSED_ENUM_ID=
KOMMO_DEFAULT_RESPONSIBLE_USER_ID=
# Global kill switch. Keep false until development delivery is verified.
KOMMO_CHATS_MEDIA_ENABLED=false
# Independent rollout flags. Product images apply to WhatsApp and Instagram;
# catalog PDFs remain WhatsApp-only.
KOMMO_CHATS_PRODUCT_IMAGES_ENABLED=false
KOMMO_CHATS_CATALOG_PDF_ENABLED=false
# Optional local monitoring allowance. Kommo remains authoritative for quota and billing.
KOMMO_CHATS_API_MONTHLY_LIMIT=
# Keep empty until the PDF attachment type is live-tested in the development account.
KOMMO_CHATS_PDF_ATTACHMENT_TYPE=

# --- LLM Providers (at least one required; admin picks the active one) ---
# Kommo voice/audio transcription always uses OpenAI, even when Anthropic handles chat.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Database (PostgreSQL) ---
# Local example. On Railway set DATABASE_URL=${{StorePostgres.DATABASE_URL}}.
DATABASE_URL=postgresql://postgres:password@localhost:5432/store_db
# Bounded async connection pool. Defaults are sized for one Store process and
# leave substantial headroom on a PostgreSQL instance with max_connections=100.
DATABASE_POOL_MIN_SIZE=5
DATABASE_POOL_MAX_SIZE=30

# --- Google Sheets ---
# Base64-encode your service account JSON: base64 -i credentials.json
GOOGLE_SHEETS_CREDENTIALS_B64=
PRODUCT_SHEET_ID=

# --- Telegram (admin notifications) ---
# Create a bot via @BotFather, then get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# --- App config ---
STORE_NAME="Zona Pink"
OWNER_NAME=Carlos
APP_BASE_URL=https://your-app.railway.app
DEBUG=false
# Disable during a restore drill to prevent scheduled/outbound processing.
OUTBOUND_PROCESSING_ENABLED=true

# --- AI orchestration rollout ---
# Runtime DB setting ai_orchestration_mode takes precedence when present.
# Allowed values: legacy, shadow, multi_agent. Keep legacy until rollout.
AI_ORCHESTRATION_MODE=multi_agent

# Store admin auth (required when DEBUG=false; generate with: python -c "import secrets; print(secrets.token_urlsafe(24))")
ADMIN_PASSWORD=

# --- Multi-store / customization ---
# If set, replaces prompts/system_prompt.md. Must keep the same template placeholders.
SYSTEM_PROMPT_OVERRIDE=

# When true, LLM controls are locked locally and managed from master/.
LLM_MANAGED_EXTERNALLY=false

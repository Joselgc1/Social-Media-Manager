{
  "widget": {
    "name": "widget.name",
    "description": "widget.description",
    "short_description": "widget.short_description",
    "version": "1.2.7",
    "interface_version": 2,
    "init_once": true,
    "locale": ["en", "es"],
    "installation": true
  },
  "locations": [
    "settings",
    "salesbot_designer"
  ],
  "tour": {
    "is_tour": true,
    "tour_images": {
      "en": ["/images/tour_1_en.png"],
      "es": ["/images/tour_1_es.png"]
    },
    "tour_description": "widget.tour_description"
  },
  "settings": {
    "backend_url": {
      "name": "settings.backend_url",
      "type": "text",
      "required": true
    }
  },
  "salesbot_designer": {
    "logo": "/widgets/__WIDGET_CODE__/images/logo_small.png",
    "kommo_ai_private_message": {
      "name": "salesbot.private_message_handler_name",
      "settings": {
        "webhook_url": {
          "name": "salesbot.webhook_url",
          "default_value": "",
          "type": "url",
          "manual": true
        }
      }
    },
    "kommo_ai_instagram_comment": {
      "name": "salesbot.instagram_comment_handler_name",
      "settings": {
        "webhook_url": {
          "name": "salesbot.webhook_url",
          "default_value": "",
          "type": "url",
          "manual": true
        }
      }
    }
  }
}

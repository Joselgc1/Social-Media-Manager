# Master Control Plane — Environment Variables

# Master database (separate Supabase project)
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:6543/postgres

# Authentication — Bearer token for accessing the master dashboard
# Generate a strong random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
MASTER_SECRET_KEY=change-me-to-a-strong-random-string

# Encryption key for storing store credentials at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-with-fernet

# Railway API token (optional unless deploying store credentials from the master dashboard)
RAILWAY_API_TOKEN=

# Base URL of this master service
APP_BASE_URL=http://localhost:9000

# Health check interval in seconds (default: 300 = 5 minutes)
HEALTH_CHECK_INTERVAL_SECONDS=300

# Max parallel connections when fetching per-store stats (Supabase session pooler is limited)
# Lower this (e.g. 1–2) if you still see "MaxClientsInSessionMode" with master + stores running.
STORE_STATS_MAX_CONCURRENT=1

# Store deployment variables managed from the master dashboard can include:
# CHANNEL_BACKEND=meta|kommo
# KOMMO_SUBDOMAIN=
# KOMMO_ACCESS_TOKEN=
# KOMMO_INTEGRATION_ID=
# KOMMO_INTEGRATION_SECRET=
# KOMMO_SALESBOT_ID=
# KOMMO_WEBHOOK_SECRET=
# KOMMO_AI_MODE_FIELD_ID=
# KOMMO_AI_ACTIVE_ENUM_ID=
# KOMMO_AI_HUMAN_ENUM_ID=
# KOMMO_AI_PAUSED_ENUM_ID=
# KOMMO_DEFAULT_RESPONSIBLE_USER_ID=

# Master Control Plane — Environment Variables

# Master database (separate PostgreSQL database)
# Local example. On Railway set DATABASE_URL=${{MasterPostgres.DATABASE_URL}}.
DATABASE_URL=postgresql://postgres:password@localhost:5432/master_db

# Authentication — Bearer token for accessing the master dashboard
# Generate a strong random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
MASTER_SECRET_KEY=

# Encryption key for storing store credentials at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Railway API token (optional unless deploying store credentials from the master dashboard)
RAILWAY_API_TOKEN=

# Base URL of this master service (required; test endpoints only work on exact loopback hosts)
APP_BASE_URL=http://localhost:9000

# Health check interval in seconds (default: 300 = 5 minutes)
HEALTH_CHECK_INTERVAL_SECONDS=300
# Maximum store health requests in flight at once
HEALTH_CHECK_MAX_CONCURRENT=10

# Max parallel connections when fetching per-store stats.
# Lower this for database providers with smaller connection-pool limits.
STORE_STATS_MAX_CONCURRENT=1

# Exchange-rate refresh (never sent to stores)
DOLARVZLA_BCV_REFRESH_MINUTES=45
DOLARVZLA_USDT_REFRESH_MINUTES=60
DOLARVZLA_USDT_STALE_MINUTES=120
DOLARVZLA_HTTP_TIMEOUT_SECONDS=10
DOLARVZLA_HTTP_RETRIES=2
DOLARVZLA_RETRY_BACKOFF_SECONDS=1

# Store deployment variables managed from the master dashboard can include:
# CHANNEL_BACKEND=meta|kommo
# KOMMO_SUBDOMAIN=
# KOMMO_ACCESS_TOKEN=
# KOMMO_INTEGRATION_ID=
# KOMMO_INTEGRATION_SECRET=
# KOMMO_INSTAGRAM_DM_SALESBOT_ID=
# KOMMO_WHATSAPP_SALESBOT_ID=
# KOMMO_SALESBOT_ID=  # Temporary fallback
# KOMMO_WEBHOOK_SECRET=
# KOMMO_AI_MODE_FIELD_ID=
# KOMMO_AI_ACTIVE_ENUM_ID=
# KOMMO_AI_HUMAN_ENUM_ID=
# KOMMO_AI_PAUSED_ENUM_ID=
# KOMMO_DEFAULT_RESPONSIBLE_USER_ID=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=
